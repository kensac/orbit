#!/bin/sh
# A git credential helper (gitcredentials(7)) answering github.com over
# HTTPS with orbit's token from /run/orbit/gh-token. Without the file it
# answers nothing, so git asks the next helper (one `gh auth setup-git`
# configured, say).
[ "$1" = get ] || exit 0
[ -s /run/orbit/gh-token ] || exit 0
host=
while IFS= read -r line && [ -n "$line" ]; do
	case $line in
	host=*) host=${line#host=} ;;
	esac
done
[ "$host" = github.com ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat /run/orbit/gh-token)"
