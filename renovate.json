{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "branchPrefix": "renovate/",
  "labels": ["dependencies", "renovate"],
  "timezone": "America/New_York",
  "pinDigests": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "platformAutomerge": true,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "non-major dependencies",
      "automerge": true,
      "automergeStrategy": "squash"
    },
    {
      "description": "The agent CLIs change the backend's behavior and flags orbit parses; a release is reviewed, not automerged.",
      "matchFileNames": ["deploy/cli/**"],
      "groupName": "agent CLIs",
      "automerge": false
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Release binaries in Dockerfiles pinned by version and sha256 (yq in deploy/workstation.Dockerfile): the comment names the release, the ARG holds the version and that asset's checksum, which Renovate recomputes from the new release.",
      "managerFilePatterns": ["/(^|/)[^/]*\\.Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nARG \\S+?=(?<currentValue>\\S+) \\S+?=(?<currentDigest>[a-f0-9]{64})"
      ]
    }
  ]
}
